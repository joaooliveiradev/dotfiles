{
	// ===== VIM =====
	"disable_ai": true,
	"vim_mode": true,
	"relative_line_numbers": "enabled",
	"vim": {
		"use_system_clipboard": "always"
	},

	// ===== EDITOR SETTINGS =====
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_size": 18,
	"ui_font_family": "JetBrains Mono",
	"ui_font_size": 18,
	"tab_size": 2,
	"icon_theme": "Symbols Icon Theme",
	"theme": "Tokyo Night",

	// TOOLBAR
	"toolbar": {
		"breadcrumbs": false,
		"quick_actions": false
	},

	// TITLE BAR
	"title_bar": {
		"show_sign_in": false,
		"show_project_items": false,
		"show_branch_name": false,
		"show_user_menu": false,
		"show_branch_icon": false,
		"show_user_picture": false,
		"show_onboarding_banner": false,
		"show_menus": false
	},

	// ===== TABS ======
	"tabs": {
		"file_icons": true,
		"git_status": true
	},

	// ==== TAB BAR ====
	"tab_bar": {
		"show_nav_history_buttons": false,
		"show_tab_bar_buttons": false
	},

	// ==== STATUS BAR ====
	"status_bar": {
		"experimental.show": false
	},

	// ===== INDENTATION =====
	"indent_guides": {
		"enabled": true,
		"coloring": "indent_aware"
	},

	// ===== FILE MANAGEMENT =====
	"format_on_save": "on", // Auto-format files on save
	"ensure_final_newline_on_save": true,
	"remove_trailing_whitespace_on_save": true,

	// ===== TERMINAL =====
	"terminal": {
		"shell": {
			"program": "zsh"
		},
		"font_family": "JetBrains Mono",
		"font_size": 16,
		"line_height": "comfortable"
	},

	// ===== GIT =====
	"git": {
		"inline_blame": {
			"enabled": true,
			"delay_ms": 600
		}
	},

	// ===== PERFORMANCE ======
	"file_scan_exclusions": ["**/.git", "**/build"],

	// ===== LSP & INTELLISENSE =====
	"inlay_hints": {
		"show_value_hints": true,
		"enabled": false,
		"show_type_hints": true,
		"show_parameter_hints": true
	},

	// ===== PROJECT & FILES =====
	"project_panel": {
		"dock": "right",
		"hide_root": true,
		"auto_fold_dirs": false
	},

	// ===== AGENT =====
	"agent": {
		"dock": "left"
	},

	// ===== TELEMETRY =====
	"telemetry": {
		"diagnostics": false, // Send crash reports
		"metrics": false // Send usage statistics
	},

	"formatter": "language_server",
	"language_servers": ["biome"],

	// ===== LANGUAGE-SPECIFIC =====
	"languages": {
		"JavaScript": {
			"tab_size": 2,
			"format_on_save": "on"
		},
		"TypeScript": {
			"tab_size": 2,
			"format_on_save": "on"
		}
	}
}
