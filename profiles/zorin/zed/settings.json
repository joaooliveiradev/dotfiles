{
  // ===== VIM MODE =====
  "vim_mode": true,
  "relative_line_numbers": "enabled", // Great for vim mode

  // ===== EDITOR SETTINGS =====
  "ui_font_family": ".ZedSans",
  "buffer_font_size": 18,
  "ui_font_size": 18,
  "tab_size": 2,
  "wrap_guides": [80, 100],
  "icon_theme": "Symbols Icon Theme",
  "theme": "Tokyo Night",

  "toolbar": {
    "breadcrumbs": true,
  },

  "title_bar": {
    "show_sign_in": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
    "show_branch_icon": false,
    "show_user_picture": false,
    "show_onboarding_banner": false,
    "show_menus": false,
  },

  // ===== TABS ======
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  "status_bar": {
    "experimental.show": false,
  },

  // ===== INDENTATION =====
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },

  // ===== FILE MANAGEMENT =====
  "autosave": "on_focus_change", // Options: "off", "after_delay", "on_focus_change", "on_window_change"
  "format_on_save": "on", // Auto-format files on save
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,

  // ===== TERMINAL =====
  "terminal": {
    "shell": {
      "program": "zsh",
    },
    "font_family": "JetBrains Mono",
    "font_size": 16,
    "line_height": "comfortable", // Options: "comfortable", "standard", "relaxed"
  },

  // ===== GIT =====
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
    },
  },

  "file_scan_exclusions": ["**/.git", "**/build"],

  // ===== LSP & INTELLISENSE =====
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
  },

  // ===== PROJECT & FILES =====
  "project_panel": {
    "dock": "right",
    "hide_root": true,
    "auto_fold_dirs": false,
  },

  "agent": {
    "dock": "left",
  },

  // ===== LANGUAGE-SPECIFIC =====
  "languages": {
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
    },
  },

  // ===== TELEMETRY =====
  "telemetry": {
    "diagnostics": false, // Send crash reports
    "metrics": false, // Send usage statistics
  },
}
